# Copy to `.env` and adjust as needed.
# `.env` is gitignored — never commit real secrets.

# ---------------------------------------------------------------------------
# Runtime
# ---------------------------------------------------------------------------
# One of: development | staging | production
# In `production`, /docs, /redoc, and /openapi.json are disabled.
ENVIRONMENT=development

# ---------------------------------------------------------------------------
# Database (Postgres + asyncpg)
# ---------------------------------------------------------------------------
# Format: postgresql+asyncpg://USER:PASSWORD@HOST:PORT/DBNAME
# - Local dev example shown below.
# - Special characters in the password must be URL-encoded.
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/compiquest-demo

# Echo SQL to stdout. Handy for debugging; leave off in production.
DB_ECHO=false

# Connection pool tuning (optional; defaults are fine for most apps).
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10

# ---------------------------------------------------------------------------
# JWT / Auth
# ---------------------------------------------------------------------------
# Symmetric secret used to sign access tokens. MUST be set to a strong
# random value in production. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET_KEY=dev-insecure-CHANGE-ME-before-production

# Signing algorithm. HS256 (HMAC-SHA256) is fine for single-service apps.
# Use RS256/EdDSA if you need asymmetric signing across services.
JWT_ALGORITHM=HS256

# Access token lifetime in minutes.
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Refresh token lifetime in days. Refresh tokens are exchanged for new
# access tokens via /auth/refresh; rotation revokes the old refresh
# token on every successful refresh.
REFRESH_TOKEN_EXPIRE_DAYS=14

# ---------------------------------------------------------------------------
# Token deny-list (Redis or in-memory)
# ---------------------------------------------------------------------------
# Optional Redis URL for the JWT deny-list. When set, revoked tokens
# are stored in Redis with a TTL equal to the token's remaining
# lifetime. When unset (the default), the deny-list falls back to a
# process-local dict — fine for single-instance dev, NOT safe for
# multi-replica production deployments where one replica's logout
# must apply to traffic on all replicas.
#   REDIS_URL=redis://host:6379/0
REDIS_URL=

# ---------------------------------------------------------------------------
# Logging
# ---------------------------------------------------------------------------
# Root log level: DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=INFO

# ---------------------------------------------------------------------------
# CORS
# ---------------------------------------------------------------------------
# Comma-separated list of allowed origins. Leave empty (the default)
# to disable CORS entirely. In production, set explicit origins —
# never use "*" with allow_credentials=true.
#   CORS_ALLOW_ORIGINS=https://app.example.com,https://staging.example.com
CORS_ALLOW_ORIGINS=
CORS_ALLOW_CREDENTIALS=true
CORS_ALLOW_METHODS=GET,POST,PUT,PATCH,DELETE,OPTIONS
CORS_ALLOW_HEADERS=*

# ---------------------------------------------------------------------------
# Rate limiting (slowapi)
# ---------------------------------------------------------------------------
# Storage URI for the limiter. Defaults to in-memory (per-process).
# For multi-pod deployments, use Redis: redis://host:6379/0
RATE_LIMIT_STORAGE_URI=memory://

# Per-IP limits applied to the most-abused endpoints.
# slowapi syntax: "<count>/<period>" where period is
# second / minute / hour / day.
RATE_LIMIT_LOGIN=50/15minutes
RATE_LIMIT_REGISTER=10/hour

# ---------------------------------------------------------------------------
# AWS Bedrock — the only LLM backend (iQuest rationale/chat, CompChat, CD&A)
# ---------------------------------------------------------------------------
# Credentials are resolved from the standard AWS credential chain:
# env vars (AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY / AWS_SESSION_TOKEN),
# ~/.aws/credentials, or an EC2/ECS instance profile.
AWS_REGION=ap-south-1
BEDROCK_MODEL_ID=deepseek.v3.2
# Optional — omit to use the ambient AWS credential chain instead.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=

# ---------------------------------------------------------------------------
# Bootstrap (CLI only)
# ---------------------------------------------------------------------------
# Used by ``compiqcorebe bootstrap-super-admin`` to create the first
# SUPER_ADMIN on a fresh deployment. Idempotent — once a super-admin
# exists, subsequent runs are no-ops. After the first deploy, set
# these to empty / unset them in your secret manager.
INIT_SUPER_ADMIN_EMAIL=
INIT_SUPER_ADMIN_PASSWORD=
